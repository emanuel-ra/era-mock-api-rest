{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "testEnvironment": "node",
  "reporters": [
    "default",
    ["jest-html-reporters", {
      "publicPath": "./reports/e2e",
      "filename": "report.html",
      "pageTitle": "Mock API - E2E tests",
      "expand": true
    }]
  ]
}
