meta {
  name: Create category
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno {{$timestamp}}",
    "description": "Created from the Bruno collection"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("categoryId", res.body.id);
}
