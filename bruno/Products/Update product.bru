meta {
  name: Update product
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/products/{{productId}}
  body: json
  auth: inherit
}

body:json {
  {
    "price": 9.99,
    "stock": 0,
    "status": "out_of_stock",
    "categoryId": null
  }
}

assert {
  res.status: eq 200
}

docs {
  Send `categoryId: null` to remove the category.
}
