meta {
  name: List products with most stock
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/products?status=active&sortBy=stock&order=desc&limit=1
  body: none
  auth: inherit
}

params:query {
  status: active
  sortBy: stock
  order: desc
  limit: 1
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("stockProductId", res.body.data[0].id);
}

docs {
  Saves the active product with the most stock as `stockProductId`, used by the Orders folder.
}
