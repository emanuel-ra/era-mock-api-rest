meta {
  name: Create user
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Bruno User",
    "email": "bruno-user-{{$timestamp}}@example.com",
    "password": "password123",
    "role": "user"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setVar("userId", res.body.id);
}
