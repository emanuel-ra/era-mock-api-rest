meta {
  name: Login user
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "user@mock.dev",
    "password": "password123"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("token", res.body.accessToken);
}
