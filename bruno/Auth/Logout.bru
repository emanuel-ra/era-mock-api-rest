meta {
  name: Logout
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 204
}

docs {
  Invalidates the refresh token saved by a Login or Refresh request. Always 204, even if the token is unknown or already used.
  The saved access token keeps working until it expires; run a Login request again to get a new refresh token.
}
