meta {
  name: Refresh
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setEnvVar("token", res.body.accessToken);
  bru.setEnvVar("refreshToken", res.body.refreshToken);
}

docs {
  Exchanges the refresh token saved by a Login request for a new pair and saves both.
  Each refresh token works once: running this twice without the script saving the new one returns 401.
}
