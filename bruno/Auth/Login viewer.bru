meta {
  name: Login viewer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "viewer@mock.dev",
    "password": "password123"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  bru.setEnvVar("token", res.body.accessToken);
}

docs {
  Read-only role: can list and get, but gets 403 on create/update/delete.
}
